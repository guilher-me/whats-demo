{
  "version": 1,
  "contact": {
    "name": "Luma Home",
    "avatar": "assets/luma-home.svg",
    "verified": true
  },
  "steps": [
    {
      "id": "hello",
      "type": "user",
      "text": "Hi! I’m looking for a new lamp.",
      "delay": 0.4
    },
    {
      "id": "welcome",
      "type": "business",
      "text": "Welcome to *Luma Home*! ✨\nThoughtful lighting for a place that feels like you. Where would you like to start?",
      "delay": 1,
      "typing": true,
      "interactive": {
        "kind": "buttons",
        "footer": "A fictional store. A real feel for the experience.",
        "buttons": [
          {
            "id": "collection",
            "title": "Browse collection"
          },
          {
            "id": "bestsellers",
            "title": "See bestsellers"
          }
        ],
        "autoReplyId": "collection"
      }
    },
    {
      "id": "collection",
      "type": "business",
      "text": "Meet our favorites. Tap below to explore a piece for your home.",
      "delay": 0.8,
      "typing": true,
      "interactive": {
        "kind": "list",
        "button": "Explore lamps",
        "sections": [
          {
            "title": "Table lamps",
            "rows": [
              {
                "id": "beam",
                "title": "Beam table lamp",
                "description": "Warm light, sculpted ceramic · $49"
              },
              {
                "id": "arc",
                "title": "Arc desk lamp",
                "description": "An adjustable everyday favorite · $65"
              }
            ]
          },
          {
            "title": "Floor lamps",
            "rows": [
              {
                "id": "halo",
                "title": "Halo floor lamp",
                "description": "A soft glow for your reading corner · $119"
              }
            ]
          }
        ],
        "autoReplyId": "beam"
      }
    },
    {
      "id": "request",
      "type": "flow",
      "text": "Found your favorite? Tell us the details in this short form.\n_No payment is required._",
      "delay": 0.8,
      "typing": true,
      "label": "Create a request",
      "completion": "Product request sent",
      "answers": {
        "product": "beam",
        "color": "sand",
        "quantity": "1",
        "name": "Alex Taylor",
        "email": "alex@example.com",
        "fulfillment": "pickup"
      },
      "flow": {
        "version": "7.3",
        "routing_model": {
          "PRODUCT": ["CONTACT"]
        },
        "screens": [
          {
            "id": "PRODUCT",
            "title": "Your piece",
            "layout": {
              "type": "SingleColumnLayout",
              "children": [
                {
                  "type": "TextHeading",
                  "text": "Make it yours"
                },
                {
                  "type": "RadioButtonsGroup",
                  "name": "product",
                  "label": "Choose your lamp",
                  "required": true,
                  "data-source": [
                    {
                      "id": "beam",
                      "title": "Beam table lamp · $49"
                    },
                    {
                      "id": "arc",
                      "title": "Arc desk lamp · $65"
                    },
                    {
                      "id": "halo",
                      "title": "Halo floor lamp · $119"
                    }
                  ]
                },
                {
                  "type": "RadioButtonsGroup",
                  "name": "color",
                  "label": "Choose a finish",
                  "required": true,
                  "data-source": [
                    {
                      "id": "sand",
                      "title": "Warm sand"
                    },
                    {
                      "id": "forest",
                      "title": "Forest green"
                    }
                  ]
                },
                {
                  "type": "TextInput",
                  "name": "quantity",
                  "label": "Quantity",
                  "required": true,
                  "input-type": "number"
                },
                {
                  "type": "Footer",
                  "label": "Continue",
                  "on-click-action": {
                    "name": "navigate",
                    "next": {
                      "type": "screen",
                      "name": "CONTACT"
                    },
                    "payload": {
                      "product": "${form.product}",
                      "color": "${form.color}",
                      "quantity": "${form.quantity}"
                    }
                  }
                }
              ]
            }
          },
          {
            "id": "CONTACT",
            "title": "Your details",
            "terminal": true,
            "data": {
              "product": {
                "type": "string",
                "__example__": "beam"
              },
              "color": {
                "type": "string",
                "__example__": "sand"
              },
              "quantity": {
                "type": "string",
                "__example__": "1"
              }
            },
            "layout": {
              "type": "SingleColumnLayout",
              "children": [
                {
                  "type": "TextBody",
                  "text": "This is a demo request. Please use fictional contact details."
                },
                {
                  "type": "TextInput",
                  "name": "name",
                  "label": "Your name",
                  "required": true,
                  "input-type": "text"
                },
                {
                  "type": "TextInput",
                  "name": "email",
                  "label": "Email address",
                  "required": true,
                  "input-type": "email"
                },
                {
                  "type": "RadioButtonsGroup",
                  "name": "fulfillment",
                  "label": "How would you like to receive it?",
                  "required": true,
                  "data-source": [
                    {
                      "id": "pickup",
                      "title": "Collect in store"
                    },
                    {
                      "id": "delivery",
                      "title": "Home delivery"
                    }
                  ]
                },
                {
                  "type": "Footer",
                  "label": "Send request",
                  "on-click-action": {
                    "name": "complete",
                    "payload": {
                      "product": "${data.product}",
                      "color": "${data.color}",
                      "quantity": "${data.quantity}",
                      "name": "${form.name}",
                      "email": "${form.email}",
                      "fulfillment": "${form.fulfillment}"
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "confirmation",
      "type": "business",
      "text": "Thanks! Your request is *LH-1042*.\nI’m Emma from Luma Home. I’ll help you check availability and the next steps.\n\n_This demo does not place an order or collect payment._",
      "delay": 2.5,
      "typing": true
    }
  ]
}
