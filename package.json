{
  "name": "whatsapp-fake-flows",
  "version": "0.2.0",
  "description": "Editor de conversas e WhatsApp Flows com React, TypeScript e HTML portátil",
  "scripts": {
    "dev": "node -e \"require(require('path').join(require('path').dirname(process.env.npm_package_json),'scripts','tasks.cjs')).run('dev').catch(e=>{console.error(e);process.exitCode=1})\"",
    "build": "node -e \"require(require('path').join(require('path').dirname(process.env.npm_package_json),'scripts','tasks.cjs')).run('build').catch(e=>{console.error(e);process.exitCode=1})\"",
    "test": "node -e \"require(require('path').join(require('path').dirname(process.env.npm_package_json),'scripts','tasks.cjs')).run('test').catch(e=>{console.error(e);process.exitCode=1})\"",
    "typecheck": "node -e \"require(require('path').join(require('path').dirname(process.env.npm_package_json),'scripts','tasks.cjs')).run('typecheck').catch(e=>{console.error(e);process.exitCode=1})\"",
    "format": "node -e \"require(require('path').join(require('path').dirname(process.env.npm_package_json),'scripts','tasks.cjs')).run('format').catch(e=>{console.error(e);process.exitCode=1})\"",
    "format:check": "node -e \"require(require('path').join(require('path').dirname(process.env.npm_package_json),'scripts','tasks.cjs')).run('format:check').catch(e=>{console.error(e);process.exitCode=1})\""
  },
  "author": "Guilherme Cardoso",
  "license": "MIT",
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module"
}
