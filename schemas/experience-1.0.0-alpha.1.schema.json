{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WhatsDemo experience alpha 1",
  "type": "object",
  "required": [
    "format",
    "schemaVersion",
    "metadata",
    "participants",
    "resources",
    "journey",
    "playback"
  ],
  "properties": {
    "format": {
      "const": "whatsdemo"
    },
    "schemaVersion": {
      "const": "1.0.0-alpha.1"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "title",
        "contentLocale"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "contentLocale": {
          "type": "string"
        }
      }
    },
    "participants": {
      "type": "object",
      "required": [
        "business",
        "customer"
      ]
    },
    "resources": {
      "type": "object",
      "required": [
        "assets",
        "flows",
        "templates"
      ],
      "properties": {
        "attachments": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": ["id", "kind", "name", "customerVisible"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,100}$" },
              "kind": { "enum": ["image", "document"] },
              "name": { "type": "string", "minLength": 1, "maxLength": 120 },
              "customerVisible": { "type": "boolean" },
              "assetId": { "type": "string" },
              "coverAssetId": { "type": "string" },
              "sizeLabel": { "type": "string", "minLength": 1, "maxLength": 24 }
            },
            "additionalProperties": false,
            "if": { "properties": { "kind": { "const": "image" } } },
            "then": {
              "required": ["assetId"],
              "properties": { "coverAssetId": false, "sizeLabel": false }
            },
            "else": {
              "required": ["sizeLabel"],
              "properties": { "assetId": false }
            }
          }
        }
      }
    },
    "journey": {
      "type": "object",
      "required": [
        "steps"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "sender",
              "message"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "message"
              },
              "sender": {
                "enum": [
                  "business",
                  "customer"
                ]
              },
              "message": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "text",
                      "voice_mock",
                      "image",
                      "document_mock",
                      "interactive",
                      "template"
                    ]
                  },
                  "image": {
                    "type": "object",
                    "properties": { "caption": { "type": "string", "maxLength": 1024 } },
                    "additionalProperties": false
                  }
                }
              },
              "simulation": {
                "type": "object",
                "properties": {
                  "recordingSeconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 120
                  }
                }
              },
              "bindings": {
                "type": "object",
                "properties": { "attachmentId": { "type": "string" } }
              }
            },
            "if": {
              "properties": {
                "message": {
                  "properties": {
                    "type": {
                      "const": "voice_mock"
                    }
                  }
                }
              }
            },
            "then": {
              "required": [
                "simulation"
              ],
              "properties": {
                "sender": {
                  "const": "customer"
                },
                "simulation": {
                  "required": [
                    "recordingSeconds"
                  ]
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "message": { "properties": { "type": { "enum": ["image", "document_mock"] } } }
                  }
                },
                "then": {
                  "required": ["bindings"],
                  "properties": { "bindings": { "required": ["attachmentId"] } }
                }
              }
            ]
          }
        }
      }
    },
    "playback": {
      "type": "object",
      "required": [
        "userPace"
      ],
      "properties": {
        "userPace": {
          "enum": [
            0.5,
            1,
            1.5,
            2,
            3
          ]
        }
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
