{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WhatsDemo experience alpha 1",
  "type": "object",
  "required": [
    "format",
    "schemaVersion",
    "metadata",
    "participants",
    "resources",
    "journey",
    "playback"
  ],
  "properties": {
    "format": {
      "const": "whatsdemo"
    },
    "schemaVersion": {
      "const": "1.0.0-alpha.1"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "title",
        "contentLocale"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "contentLocale": {
          "type": "string"
        }
      }
    },
    "participants": {
      "type": "object",
      "required": [
        "business",
        "customer"
      ]
    },
    "resources": {
      "type": "object",
      "required": [
        "assets",
        "flows",
        "templates"
      ]
    },
    "journey": {
      "type": "object",
      "required": [
        "steps"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "sender",
              "message"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "message"
              },
              "sender": {
                "enum": [
                  "business",
                  "customer"
                ]
              },
              "message": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "text",
                      "interactive",
                      "template"
                    ]
                  }
                }
              },
              "simulation": {
                "type": "object"
              },
              "bindings": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "playback": {
      "type": "object",
      "required": [
        "userPace"
      ],
      "properties": {
        "userPace": {
          "enum": [
            0.5,
            1,
            1.5,
            2,
            3
          ]
        }
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
